    {
      "name": "Admin Content Management",
      "item": [
        {
          "name": "Trigger Content Scraping",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Token {{admin_token}}",
                "description": "Admin authentication required"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"force_refresh\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/content/scrape_content/",
              "host": ["{{base_url}}"],
              "path": ["admin", "content", "scrape_content", ""]
            }
